# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (dev uses sqlite by default)
DATABASE_URL=sqlite:///couplefight.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/couplefight

# FX API (frankfurter.app is free and key-less)
FX_API_BASE=https://api.frankfurter.app

# Cookies — set to 1 in production behind HTTPS
SESSION_COOKIE_SECURE=0
